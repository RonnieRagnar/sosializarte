<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes"/>
    <title>Cuestionario Web — Grupo Overnet | Sosializarte</title>

    <meta name="description" content="Completa este cuestionario para construir la nueva página web de Grupo Overnet.">
    <meta name="robots" content="noindex, follow">

    <link rel="canonical" href="https://sosializarte.com/cuestionario-overnet" />
    <link rel="icon" href="/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        :root {
            --orange: #FF642E;
            --orange-dark: #E04D1A;
            --orange-glow: rgba(255, 100, 46, 0.1);
            --ink: #0d0d0d;
            --paper: #F7F4EF;
            --surface: #FDFCFA;
            --muted: #6b6b6b;
            --border: #E8E4DC;
            --border-strong: #C9C4BB;
            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 22px;
            --shadow-card: 0 2px 12px rgba(0, 0, 0, 0.05);
            --shadow-lift: 0 8px 40px rgba(0, 0, 0, 0.09);
        }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--paper);
            color: var(--ink);
            line-height: 1.6;
            padding: 40px 20px;
        }
        .container { max-width: 820px; margin: 0 auto; }
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 40px;
        }
        .logo {
            font-family: 'Bricolage Grotesque', sans-serif;
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--ink);
            text-decoration: none;
            display: flex;
            align-items: baseline;
            gap: 1px;
        }
        .logo .slash { color: var(--orange); font-weight: 900; font-size: 1.6rem; }
        .back-link {
            color: var(--orange);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .back-link:hover { color: var(--orange-dark); }
        .client-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--orange-glow);
            border: 1px solid rgba(255, 100, 46, 0.25);
            color: var(--orange-dark);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 999px;
            margin-bottom: 20px;
        }
        .progress-bar {
            background: var(--border);
            border-radius: 999px;
            height: 6px;
            margin-bottom: 8px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: var(--orange);
            border-radius: 999px;
            width: 0%;
            transition: width 0.3s ease;
        }
        .progress-label {
            text-align: right;
            font-size: 0.78rem;
            color: var(--muted);
            margin-bottom: 24px;
        }
        .section-title {
            font-family: 'Bricolage Grotesque', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .section-desc {
            color: var(--muted);
            font-size: 0.95rem;
            margin-bottom: 28px;
        }
        .form-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 40px 36px;
            box-shadow: var(--shadow-card);
        }
        .field { margin-bottom: 20px; }
        .field label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 4px; }
        .field label .required { color: #ef4444; font-weight: 700; }
        .field .hint { font-size: 0.78rem; color: var(--muted); margin-top: 2px; }
        .field input, .field textarea, .field select {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            background: var(--paper);
            color: var(--ink);
            transition: border-color 0.2s;
        }
        .field input:focus, .field textarea:focus, .field select:focus {
            outline: none;
            border-color: var(--orange);
        }
        .field textarea { min-height: 80px; resize: vertical; }

        .field.field-invalid input,
        .field.field-invalid textarea,
        .field.field-invalid select {
            border-color: #ef4444;
        }
        .field-error-msg {
            display: none;
            color: #ef4444;
            font-size: 0.78rem;
            margin-top: 4px;
            font-weight: 600;
        }
        .field.field-invalid .field-error-msg {
            display: block;
        }

        .field-checkbox-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px 16px;
            margin-top: 4px;
        }
        @media (max-width: 480px) { .field-checkbox-group { grid-template-columns: 1fr; } }
        .field-checkbox-group label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 400;
            font-size: 0.9rem;
            cursor: pointer;
        }
        .field-checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--orange);
            flex-shrink: 0;
        }
        .field-file {
            border: 2px dashed var(--border);
            border-radius: var(--radius-sm);
            padding: 24px;
            text-align: center;
            color: var(--muted);
            transition: border-color 0.2s;
            cursor: pointer;
        }
        .field-file:hover { border-color: var(--orange); }
        .field-file.file-error { border-color: #ef4444; }
        .field-file input[type="file"] { display: none; }
        .field-file .file-icon { font-size: 2rem; display: block; margin-bottom: 6px; }

        .section-error-banner {
            display: none;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #b91c1c;
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .section-error-banner.visible { display: block; }

        .form-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid var(--border);
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 28px;
            border-radius: 999px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-primary {
            background: var(--orange);
            color: #fff;
            box-shadow: 0 4px 20px rgba(255, 100, 46, 0.3);
        }
        .btn-primary:hover {
            background: var(--orange-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(255, 100, 46, 0.35);
        }
        .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .btn-secondary {
            background: transparent;
            color: var(--muted);
            border: 1.5px solid var(--border-strong);
        }
        .btn-secondary:hover {
            border-color: var(--orange);
            color: var(--orange);
        }
        .form-success {
            display: none;
            text-align: center;
            padding: 60px 20px;
        }
        .form-success.visible { display: block; }
        .form-success .icon { font-size: 3.5rem; margin-bottom: 16px; }
        .form-success h2 {
            font-family: 'Bricolage Grotesque', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .form-success p {
            color: var(--muted);
            font-size: 1rem;
            max-width: 480px;
            margin: 0 auto 24px;
        }
        .form-success .btn { margin: 0 auto; }
        .footer-note {
            text-align: center;
            color: var(--muted);
            font-size: 0.78rem;
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid var(--border);
        }
        .footer-note a { color: var(--orange); text-decoration: none; }
        .footer-note a:hover { text-decoration: underline; }
        @media (max-width: 640px) {
            body { padding: 24px 16px; }
            .form-card { padding: 24px 20px; }
            .section-title { font-size: 1.3rem; }
            .header-bar { flex-direction: column; gap: 12px; align-items: flex-start; }
            .form-actions { flex-direction: column; }
            .form-actions .btn { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header-bar">
            <a href="/" class="logo"><span class="slash">//</span>sosializarte</a>
            <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Volver al sitio</a>
        </div>

        <span class="client-tag"><i class="fas fa-video"></i> Grupo Overnet — Videovigilancia</span>

        <!-- PROGRESO -->
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>
        <div class="progress-label" id="progressLabel">Sección 1 de 5</div>

        <!-- FORMULARIO -->
        <div id="formContainer">
            <div class="form-card">
                <h1 class="section-title">🎥 Cuestionario para tu nueva Web</h1>
                <p class="section-desc">Alfredo, con esta información armamos la nueva página de Grupo Overnet enfocada 100% en lo que vendes hoy. Tómate tu tiempo, no hay respuestas incorrectas.</p>

                <div class="section-error-banner" id="sectionErrorBanner">
                    ⚠️ Faltan campos obligatorios por completar en esta sección.
                </div>

                <form id="webForm" action="https://formspree.io/f/xgogjwyp" method="POST">
                    <input type="hidden" name="_subject" value="Nuevo cuestionario — Grupo Overnet">
                    <input type="hidden" name="proyecto" value="Grupo Overnet">

                    <!-- ==================== SECCIÓN 1 ==================== -->
                    <div class="section-block" data-section="1">
                        <h2 class="section-title" style="font-size:1.2rem;">📋 Datos del negocio</h2>
                        <p class="section-desc" style="font-size:0.85rem;">Información básica para identificar tu negocio.</p>

                        <div class="field">
                            <label>Nombre comercial <span class="required">*</span></label>
                            <input type="text" name="nombre_negocio" value="Grupo Overnet" required>
                            <div class="hint">¿"Grupo Overnet" o prefieres que aparezca solo "Overnet"? Edítalo si es necesario.</div>
                            <div class="field-error-msg">Este campo es obligatorio.</div>
                        </div>

                        <div class="field">
                            <label>Eslogan (si tienes uno)</label>
                            <input type="text" name="eslogan" placeholder="Ej. Seguridad que ves, tranquilidad que sientes">
                        </div>

                        <div class="field">
                            <label>Ciudad y zona donde operas <span class="required">*</span></label>
                            <input type="text" name="ubicacion" placeholder="Ciudad, Estado" required>
                            <div class="field-error-msg">Este campo es obligatorio.</div>
                        </div>

                        <div class="field">
                            <label>Dirección exacta (si atiendes clientes en un local)</label>
                            <input type="text" name="direccion" placeholder="Calle, número, colonia, CP">
                        </div>

                        <div class="field">
                            <label>Horario de atención <span class="required">*</span></label>
                            <input type="text" name="horario" placeholder="Ej. L-V 9am-6pm, S 9am-1pm" required>
                            <div class="field-error-msg">Este campo es obligatorio.</div>
                        </div>
                    </div>

                    <!-- ==================== SECCIÓN 2 ==================== -->
                    <div class="section-block" data-section="2">
                        <h2 class="section-title" style="font-size:1.2rem;">🎨 Identidad visual</h2>
                        <p class="section-desc" style="font-size:0.85rem;">Lo que necesitamos para que la página se vea 100% Overnet.</p>

                        <div class="field">
                            <label>Logotipo</label>
                            <div class="field-file" id="logoDropzone" onclick="document.getElementById('logoInput').click()">
                                <span class="file-icon">🖼️</span>
                                <span class="file-label">Haz clic para subir tu logotipo (PNG, JPG, SVG, AI o EPS)</span>
                                <input type="file" id="logoInput" name="logo" accept="image/*,.svg,.ai,.eps">
                            </div>
                            <div class="hint">Si no tienes el archivo a la mano, dinos y lo reconstruimos a partir de la página anterior. Tamaño máximo: 10 MB.</div>
                        </div>

                        <div class="field">
                            <label>¿Mantenemos los colores actuales o prefieres colores nuevos?</label>
                            <input type="text" name="colores" placeholder="Ej. Mantener el azul y gris actuales / Prefiero algo nuevo, sugiéranme">
                        </div>

                        <div class="field">
                            <label>Fotos de instalaciones, equipos, proyectos o personal</label>
                            <div class="field-file" id="fotosDropzone" onclick="document.getElementById('fotosInput').click()">
                                <span class="file-icon">📷</span>
                                <span class="file-label">Haz clic para subir fotos</span>
                                <input type="file" id="fotosInput" name="fotos" accept="image/*" multiple>
                            </div>
                            <div class="hint">Puedes subir varias fotos. Tamaño máximo: 10 MB por archivo.</div>
                        </div>

                        <div class="field">
                            <label>Catálogo o brochure (si tienes uno en PDF)</label>
                            <div class="field-file" id="catalogoDropzone" onclick="document.getElementById('catalogoInput').click()">
                                <span class="file-icon">📄</span>
                                <span class="file-label">Haz clic para subir tu catálogo</span>
                                <input type="file" id="catalogoInput" name="catalogo" accept=".pdf,image/*">
                            </div>
                            <div class="hint">Tamaño máximo: 10 MB.</div>
                        </div>
                    </div>

                    <!-- ==================== SECCIÓN 3 ==================== -->
                    <div class="section-block" data-section="3">
                        <h2 class="section-title" style="font-size:1.2rem;">🛠️ Servicios y clientes</h2>
                        <p class="section-desc" style="font-size:0.85rem;">Marca lo que sí ofreces hoy — la página vieja tiene información desactualizada.</p>

                        <div class="field">
                            <label>Servicios que ofreces actualmente <span class="required">*</span></label>
                            <div class="field-checkbox-group">
                                <label><input type="checkbox" name="servicios" value="Venta de cámaras de seguridad"> Venta de cámaras de seguridad</label>
                                <label><input type="checkbox" name="servicios" value="Instalación de videovigilancia"> Instalación de videovigilancia</label>
                                <label><input type="checkbox" name="servicios" value="Mantenimiento de sistemas"> Mantenimiento de sistemas</label>
                                <label><input type="checkbox" name="servicios" value="Monitoreo 24/7"> Monitoreo 24/7</label>
                                <label><input type="checkbox" name="servicios" value="Alarmas"> Alarmas (intrusión / incendio)</label>
                                <label><input type="checkbox" name="servicios" value="Cercas eléctricas"> Cercas eléctricas</label>
                                <label><input type="checkbox" name="servicios" value="Control de acceso"> Control de acceso / cerraduras electrónicas</label>
                                <label><input type="checkbox" name="servicios" value="Redes y cableado"> Redes / cableado estructurado</label>
                            </div>
                            <div class="field-error-msg">Selecciona al menos un servicio.</div>
                        </div>

                        <div class="field">
                            <label>¿Ofreces algún otro servicio no listado arriba?</label>
                            <input type="text" name="servicios_otro" placeholder="Escribe aquí si aplica">
                        </div>

                        <div class="field">
                            <label>¿A quién le vendes principalmente? <span class="required">*</span></label>
                            <div class="field-checkbox-group">
                                <label><input type="checkbox" name="cliente_objetivo" value="Casas / residencias"> Casas / residencias</label>
                                <label><input type="checkbox" name="cliente_objetivo" value="Negocios / comercios"> Negocios / comercios</label>
                                <label><input type="checkbox" name="cliente_objetivo" value="Industrias / bodegas"> Industrias / bodegas</label>
                                <label><input type="checkbox" name="cliente_objetivo" value="Oficinas"> Oficinas</label>
                                <label><input type="checkbox" name="cliente_objetivo" value="Escuelas"> Escuelas</label>
                                <label><input type="checkbox" name="cliente_objetivo" value="Condominios"> Condominios</label>
                                <label><input type="checkbox" name="cliente_objetivo" value="Gobierno / instituciones"> Gobierno / instituciones</label>
                            </div>
                            <div class="field-error-msg">Selecciona al menos una opción.</div>
                        </div>

                        <div class="field">
                            <label>Marcas o fabricantes que manejas</label>
                            <input type="text" name="marcas" placeholder="Ej. Hikvision, Dahua, Uniview">
                        </div>
                    </div>

                    <!-- ==================== SECCIÓN 4 ==================== -->
                    <div class="section-block" data-section="4">
                        <h2 class="section-title" style="font-size:1.2rem;">📞 Contacto y conversión</h2>
                        <p class="section-desc" style="font-size:0.85rem;">Cómo quieres que te encuentren y qué debe hacer un prospecto al llegar a la página.</p>

                        <div class="field">
                            <label>WhatsApp <span class="required">*</span></label>
                            <input type="text" name="whatsapp" placeholder="Con código de país, ej. +52 55 1234 5678" required>
                            <div class="field-error-msg">Este campo es obligatorio.</div>
                        </div>

                        <div class="field">
                            <label>Teléfono fijo (si aplica)</label>
                            <input type="text" name="telefono" placeholder="Opcional">
                        </div>

                        <div class="field">
                            <label>Correo electrónico</label>
                            <input type="email" name="correo" placeholder="ventas@grupo-overnet.com">
                        </div>

                        <div class="field">
                            <label>Facebook</label>
                            <input type="text" name="facebook" placeholder="URL de tu página de Facebook">
                        </div>

                        <div class="field">
                            <label>Instagram</label>
                            <input type="text" name="instagram" placeholder="@usuario">
                        </div>

                        <div class="field">
                            <label>¿Qué debe hacer un prospecto al entrar a la página? <span class="required">*</span></label>
                            <div class="field-checkbox-group">
                                <label><input type="checkbox" name="cta" value="Llamar"> Llamar</label>
                                <label><input type="checkbox" name="cta" value="Enviar WhatsApp"> Enviar WhatsApp</label>
                                <label><input type="checkbox" name="cta" value="Llenar formulario"> Llenar formulario</label>
                                <label><input type="checkbox" name="cta" value="Solicitar cotización"> Solicitar cotización</label>
                            </div>
                            <div class="field-error-msg">Selecciona al menos una opción.</div>
                        </div>
                    </div>

                    <!-- ==================== SECCIÓN 5 ==================== -->
                    <div class="section-block" data-section="5">
                        <h2 class="section-title" style="font-size:1.2rem;">⭐ Diferenciadores y contenido</h2>
                        <p class="section-desc" style="font-size:0.85rem;">Lo que hace único a Overnet frente a la competencia.</p>

                        <div class="field">
                            <label>¿Cuántos años de experiencia tienen?</label>
                            <input type="text" name="anos_experiencia" placeholder="Ej. 10 años">
                        </div>

                        <div class="field">
                            <label>¿Ofrecen garantía y/o certificaciones?</label>
                            <input type="text" name="garantias" placeholder="Ej. Garantía de 1 año en instalación, certificación Hikvision">
                        </div>

                        <div class="field">
                            <label>¿Qué te hace diferente frente a la competencia?</label>
                            <textarea name="diferenciadores" rows="3" placeholder="Ej. Tiempo de respuesta, soporte post-venta, precios, calidad del equipo, etc."></textarea>
                        </div>

                        <div class="field">
                            <label>¿Hay algo de la página vieja que quieras conservar?</label>
                            <textarea name="contenido_conservar" rows="3" placeholder="Textos, secciones o ideas de grupo-overnet.com que te gustaría mantener. Si prefieres que escribamos todo nuevo, dínoslo."></textarea>
                        </div>

                        <div class="field">
                            <label>Comentarios adicionales</label>
                            <textarea name="comentarios" rows="3" placeholder="Cualquier cosa que quieras que sepamos antes de empezar"></textarea>
                        </div>
                    </div>

                    <!-- ─── BOTONES ─── -->
                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" id="prevBtn" style="visibility:hidden;">
                            <i class="fas fa-arrow-left"></i> Anterior
                        </button>
                        <button type="button" class="btn btn-primary" id="nextBtn">
                            Siguiente <i class="fas fa-arrow-right"></i>
                        </button>
                        <button type="submit" class="btn btn-primary" id="submitBtn" style="display:none;">
                            <i class="fas fa-paper-plane"></i> Enviar cuestionario
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- ─── MENSAJE DE ÉXITO ─── -->
        <div class="form-success" id="formSuccess">
            <div class="icon">🎉</div>
            <h2>¡Cuestionario enviado!</h2>
            <p>Gracias, Alfredo. Ya tenemos tu información. En los próximos días te mostramos el primer avance de la nueva página de Grupo Overnet.</p>
            <a href="/" class="btn btn-primary">Volver al sitio</a>
        </div>

        <!-- ─── FOOTER ─── -->
        <div class="footer-note">
            <p>© 2026 <a href="/">Sosializarte</a> — Automatización con IA para negocios</p>
            <p style="margin-top:4px; font-size:0.72rem;">
                <a href="/privacidad">Aviso de privacidad</a>
            </p>
        </div>
    </div>

    <script>
        const MAX_FILE_MB = 10;
        const MAX_FILE_BYTES = MAX_FILE_MB * 1024 * 1024;

        document.addEventListener('DOMContentLoaded', function() {
            const sections = Array.from(document.querySelectorAll('.section-block'));
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const submitBtn = document.getElementById('submitBtn');
            const progressFill = document.getElementById('progressFill');
            const progressLabel = document.getElementById('progressLabel');
            const sectionErrorBanner = document.getElementById('sectionErrorBanner');
            let currentSection = 0;

            function showSection(index) {
                sections.forEach((section, i) => {
                    section.style.display = (i === index) ? 'block' : 'none';
                });
                const progress = ((index + 1) / sections.length) * 100;
                progressFill.style.width = progress + '%';
                progressLabel.textContent = `Sección ${index + 1} de ${sections.length}`;
                sectionErrorBanner.classList.remove('visible');

                prevBtn.style.visibility = index === 0 ? 'hidden' : 'visible';
                if (index === sections.length - 1) {
                    nextBtn.style.display = 'none';
                    submitBtn.style.display = 'inline-flex';
                } else {
                    nextBtn.style.display = 'inline-flex';
                    submitBtn.style.display = 'none';
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // ─── VALIDACIÓN DE LA SECCIÓN ACTUAL ───
            function validateSection(index) {
                const section = sections[index];
                let valid = true;
                let firstInvalidEl = null;

                // Campos de texto/select requeridos
                section.querySelectorAll('input[type="text"][required], input[type="email"][required], textarea[required], select[required]').forEach(el => {
                    const field = el.closest('.field');
                    if (!el.value.trim()) {
                        valid = false;
                        field.classList.add('field-invalid');
                        if (!firstInvalidEl) firstInvalidEl = el;
                    } else {
                        field.classList.remove('field-invalid');
                    }
                });

                // Grupos de checkboxes requeridos (al menos uno marcado)
                const requiredCheckboxGroups = {};
                section.querySelectorAll('.field').forEach(field => {
                    const errorMsg = field.querySelector('.field-error-msg');
                    const checkboxes = field.querySelectorAll('input[type="checkbox"]');
                    if (checkboxes.length > 0 && errorMsg) {
                        const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
                        if (!anyChecked) {
                            valid = false;
                            field.classList.add('field-invalid');
                            if (!firstInvalidEl) firstInvalidEl = checkboxes[0];
                        } else {
                            field.classList.remove('field-invalid');
                        }
                    }
                });

                if (!valid) {
                    sectionErrorBanner.classList.add('visible');
                    if (firstInvalidEl) {
                        firstInvalidEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                } else {
                    sectionErrorBanner.classList.remove('visible');
                }

                return valid;
            }

            showSection(0);

            nextBtn.addEventListener('click', function() {
                if (!validateSection(currentSection)) return;
                if (currentSection < sections.length - 1) {
                    currentSection++;
                    showSection(currentSection);
                }
            });

            prevBtn.addEventListener('click', function() {
                if (currentSection > 0) {
                    currentSection--;
                    showSection(currentSection);
                }
            });

            // ─── ENVÍO DEL FORMULARIO ───
            const form = document.getElementById('webForm');
            const formContainer = document.getElementById('formContainer');
            const formSuccess = document.getElementById('formSuccess');

            form.addEventListener('submit', async function(e) {
                e.preventDefault();

                if (!validateSection(currentSection)) return;

                const submitBtnEl = document.getElementById('submitBtn');
                submitBtnEl.disabled = true;
                submitBtnEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';

                try {
                    const formData = new FormData(form);
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'Accept': 'application/json' }
                    });

                    if (response.ok) {
                        formContainer.style.display = 'none';
                        formSuccess.classList.add('visible');
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    } else {
                        throw new Error('Error en el envío');
                    }
                } catch (error) {
                    alert('Hubo un error al enviar el formulario. Por favor intenta de nuevo o contáctanos por WhatsApp.');
                    submitBtnEl.disabled = false;
                    submitBtnEl.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar cuestionario';
                }
            });

            // ─── SUBIDA DE ARCHIVOS CON VALIDACIÓN DE TAMAÑO ───
            document.querySelectorAll('.field-file input[type="file"]').forEach(input => {
                input.addEventListener('change', function() {
                    const dropzone = this.closest('.field-file');
                    const label = dropzone.querySelector('.file-label');

                    if (this.files.length === 0) {
                        label.textContent = 'Haz clic para subir archivo';
                        dropzone.classList.remove('file-error');
                        return;
                    }

                    const tooLarge = Array.from(this.files).filter(f => f.size > MAX_FILE_BYTES);

                    if (tooLarge.length > 0) {
                        dropzone.classList.add('file-error');
                        label.textContent = `⚠️ ${tooLarge[0].name} pesa más de ${MAX_FILE_MB} MB. Sube un archivo más ligero.`;
                        this.value = '';
                        return;
                    }

                    dropzone.classList.remove('file-error');
                    label.textContent = `✅ ${this.files.length} archivo(s) seleccionado(s)`;
                });
            });
        });
    </script>
</body>
